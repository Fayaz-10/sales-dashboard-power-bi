// ===============================================================================
// DAX MEASURES CATALOG FOR SALES ANALYTICS DASHBOARD
// ===============================================================================
// Project: Sales Dashboard using Power BI
// Architecture: Star Schema (Fact_Sales + 4 Dimensions)
// Compliance: Explicit Measures with Divide-by-Zero Protection & Time Intelligence
// ===============================================================================

// -------------------------------------------------------------------------------
// 1. CORE FINANCIAL MEASURES
// -------------------------------------------------------------------------------

// 1. Total Revenue
// Computes gross monetary sales realized across all valid transactions.
Total Revenue = 
SUM(Fact_Sales[Revenue])

// 2. Total Cost
// Computes the total Cost of Goods Sold (COGS).
Total Cost = 
SUM(Fact_Sales[Cost])

// 3. Total Profit
// Computes net gross profit realized after subtracting total cost from total revenue.
Total Profit = 
SUM(Fact_Sales[Profit])

// -------------------------------------------------------------------------------
// 2. VOLUME & OPERATIONAL MEASURES
// -------------------------------------------------------------------------------

// 4. Total Orders
// Counts the unique sales transactions placed.
Total Orders = 
DISTINCTCOUNT(Fact_Sales[Order_ID])

// 5. Total Customers
// Counts the unique active purchasing accounts.
Total Customers = 
DISTINCTCOUNT(Fact_Sales[Customer_ID])

// 6. Total Quantity Sold
// Aggregates total physical units sold across orders.
Total Quantity Sold = 
SUM(Fact_Sales[Quantity])

// -------------------------------------------------------------------------------
// 3. EFFICIENCY & UNIT METRICS
// -------------------------------------------------------------------------------

// 7. Profit Margin Percentage
// Calculates the overall profit margin percentage with safe zero-denominator handling.
Profit Margin % = 
DIVIDE([Total Profit], [Total Revenue], 0)

// 8. Average Order Value (AOV)
// Measures average revenue generated per individual order transaction.
Average Order Value = 
DIVIDE([Total Revenue], [Total Orders], 0)

// 9. Average Selling Price (ASP)
// Measures the realized revenue per unit product sold.
Average Selling Price = 
DIVIDE([Total Revenue], [Total Quantity Sold], 0)

// -------------------------------------------------------------------------------
// 4. TIME INTELLIGENCE & COMPARATIVE GROWTH MEASURES
// -------------------------------------------------------------------------------

// 10. Revenue Previous Month
// Shifts the evaluation context backward by one contiguous month on Dim_Date.
Revenue Previous Month = 
CALCULATE(
    [Total Revenue],
    DATEADD(Dim_Date[Date], -1, MONTH)
)

// 11. Month-over-Month Revenue Growth %
// Calculates percentage change in revenue compared to prior month.
// Returns BLANK() when previous month baseline is not available (e.g. Jan 2024).
MoM Revenue Growth % = 
VAR CurrentRev = [Total Revenue]
VAR PreviousRev = [Revenue Previous Month]
RETURN
    IF(
        ISBLANK(PreviousRev),
        BLANK(),
        DIVIDE(CurrentRev - PreviousRev, PreviousRev, 0)
    )

// 12. Revenue Previous Year
// Shifts evaluation context to the exact identical period in the previous year.
Revenue Previous Year = 
CALCULATE(
    [Total Revenue],
    SAMEPERIODLASTYEAR(Dim_Date[Date])
)

// 13. Year-over-Year Revenue Growth %
// Calculates annual expansion rate. Returns BLANK() for initial year (2024).
YoY Revenue Growth % = 
VAR CurrentRev = [Total Revenue]
VAR PreviousYearRev = [Revenue Previous Year]
RETURN
    IF(
        ISBLANK(PreviousYearRev),
        BLANK(),
        DIVIDE(CurrentRev - PreviousYearRev, PreviousYearRev, 0)
    )

// ===============================================================================
// CALENDAR TABLE DAX DEFINITION (FOR MANUAL TABLE CREATION IN POWER BI DESKTOP)
// ===============================================================================

Dim_Date = 
ADDCOLUMNS (
    CALENDAR(MIN(Fact_Sales[Order_Date]), MAX(Fact_Sales[Order_Date])),
    "Year", YEAR([Date]),
    "Quarter", "Q" & FORMAT([Date], "Q"),
    "Month_Number", MONTH([Date]),
    "Month_Name", FORMAT([Date], "MMM"),
    "Year_Month", FORMAT([Date], "yyyy-MM"),
    "Day", DAY([Date]),
    "Day_of_Week", FORMAT([Date], "ddd")
)
