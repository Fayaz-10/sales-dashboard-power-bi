table Fact_Sales
	lineageTag: 671ec1aa-da49-4413-84ba-d3534c96d59d

	measure 'Total Revenue' = SUM(Fact_Sales[Revenue])
		formatString: $#,##0.00
		lineageTag: 8b4f1343-b0d3-4694-9c9a-940b5237a626

	measure 'Total Cost' = SUM(Fact_Sales[Cost])
		formatString: $#,##0.00
		lineageTag: 19a6a3e7-18ca-4939-9f52-2699914f05e8

	measure 'Total Profit' = SUM(Fact_Sales[Profit])
		formatString: $#,##0.00
		lineageTag: 25c7a223-ab39-4251-86aa-c6411cfd520c

	measure 'Total Orders' = DISTINCTCOUNT(Fact_Sales[Order_ID])
		formatString: #,##0
		lineageTag: 0e9ac80d-df89-4f19-937e-265ddcf24fb2

	measure 'Total Customers' = DISTINCTCOUNT(Fact_Sales[Customer_ID])
		formatString: #,##0
		lineageTag: adb096d1-5e0f-4107-86f6-5cffdd6b8f31

	measure 'Total Quantity Sold' = SUM(Fact_Sales[Quantity])
		formatString: #,##0
		lineageTag: e7951e61-d064-437e-bc07-0e3bde8c6ba8

	measure 'Profit Margin %' = DIVIDE([Total Profit], [Total Revenue], 0)
		formatString: 0.00%
		lineageTag: c46b89e0-88f7-43ca-a317-12b88632ca57

	measure 'Average Order Value' = DIVIDE([Total Revenue], [Total Orders], 0)
		formatString: $#,##0.00
		lineageTag: 505c9d62-1597-4d2b-8275-e3bc6f6fb361

	measure 'Average Selling Price' = DIVIDE([Total Revenue], [Total Quantity Sold], 0)
		formatString: $#,##0.00
		lineageTag: a4bb6594-a696-44a3-86cd-a4dff48699bb

	measure 'Revenue Previous Month' = CALCULATE([Total Revenue], DATEADD(Dim_Date[Date], -1, MONTH))
		formatString: $#,##0.00
		lineageTag: eaf5dfe0-fab9-4d33-89c0-12905de94737

	measure 'MoM Revenue Growth %' = VAR CurrentRev = [Total Revenue] VAR PreviousRev = [Revenue Previous Month] RETURN IF(ISBLANK(PreviousRev), BLANK(), DIVIDE(CurrentRev - PreviousRev, PreviousRev, 0))
		formatString: 0.00%
		lineageTag: 609d7c9b-5b08-4576-9a16-b6af94530285

	measure 'Revenue Previous Year' = CALCULATE([Total Revenue], SAMEPERIODLASTYEAR(Dim_Date[Date]))
		formatString: $#,##0.00
		lineageTag: 8ddd646d-d93c-46fd-b8ed-7ad32ac107e6

	measure 'YoY Revenue Growth %' = VAR CurrentRev = [Total Revenue] VAR PreviousYearRev = [Revenue Previous Year] RETURN IF(ISBLANK(PreviousYearRev), BLANK(), DIVIDE(CurrentRev - PreviousYearRev, PreviousYearRev, 0))
		formatString: 0.00%
		lineageTag: da896944-2e50-44b4-8291-80f052ee2c44

