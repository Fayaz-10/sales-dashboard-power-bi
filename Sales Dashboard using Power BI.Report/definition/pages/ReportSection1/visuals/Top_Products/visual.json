{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.12.0/schema.json",
  "name": "Top_Products",
  "position": {
    "x": 590,
    "y": 575,
    "z": 12000,
    "height": 310,
    "width": 670
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Dim_Product"
                    }
                  },
                  "Property": "Product_Name"
                }
              },
              "queryRef": "Dim_Product.Product_Name",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Fact_Sales"
                    }
                  },
                  "Property": "Total Revenue"
                }
              },
              "queryRef": "Fact_Sales.Total Revenue"
            }
          ]
        }
      }
    }
  }
}