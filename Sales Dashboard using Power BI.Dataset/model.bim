{
  "name": "Sales_Dashboard_Model",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true,
      "fastCombine": true
    },
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"Fact_Sales\",\"Dim_Date\",\"Dim_Customer\",\"Dim_Product\",\"Dim_Region\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "1"
      },
      {
        "name": "PBIDesktopVersion",
        "value": "2.157.1354.0"
      },
      {
        "name": "PBI_ProTooling",
        "value": "[\"DevMode\"]"
      },
      {
        "name": "PBI_EnhancedModelMetadata",
        "value": "1"
      }
    ],
    "tables": [
      {
        "name": "Fact_Sales",
        "columns": [
          {
            "name": "Order_ID",
            "dataType": "string",
            "sourceColumn": "Order_ID"
          },
          {
            "name": "Order_Date",
            "dataType": "dateTime",
            "sourceColumn": "Order_Date",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "Customer_ID",
            "dataType": "string",
            "sourceColumn": "Customer_ID"
          },
          {
            "name": "Customer_Name",
            "dataType": "string",
            "sourceColumn": "Customer_Name"
          },
          {
            "name": "Segment",
            "dataType": "string",
            "sourceColumn": "Segment"
          },
          {
            "name": "Region",
            "dataType": "string",
            "sourceColumn": "Region"
          },
          {
            "name": "Product_ID",
            "dataType": "string",
            "sourceColumn": "Product_ID"
          },
          {
            "name": "Product_Name",
            "dataType": "string",
            "sourceColumn": "Product_Name"
          },
          {
            "name": "Category",
            "dataType": "string",
            "sourceColumn": "Category"
          },
          {
            "name": "Sub_Category",
            "dataType": "string",
            "sourceColumn": "Sub_Category"
          },
          {
            "name": "Quantity",
            "dataType": "int64",
            "sourceColumn": "Quantity"
          },
          {
            "name": "Unit_Price",
            "dataType": "double",
            "sourceColumn": "Unit_Price",
            "formatString": "$#,##0.00"
          },
          {
            "name": "Discount",
            "dataType": "double",
            "sourceColumn": "Discount",
            "formatString": "0.0%"
          },
          {
            "name": "Sales",
            "dataType": "double",
            "sourceColumn": "Sales",
            "formatString": "$#,##0.00"
          },
          {
            "name": "Profit",
            "dataType": "double",
            "sourceColumn": "Profit",
            "formatString": "$#,##0.00"
          }
        ],
        "partitions": [
          {
            "name": "Fact_Sales-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"D:/Git Hub Projects/data/cleaned_sales_data.csv\"),[Delimiter=\",\", Columns=15, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\",{{\"Order_ID\", type text}, {\"Order_Date\", type datetime}, {\"Customer_ID\", type text}, {\"Customer_Name\", type text}, {\"Segment\", type text}, {\"Region\", type text}, {\"Product_ID\", type text}, {\"Product_Name\", type text}, {\"Category\", type text}, {\"Sub_Category\", type text}, {\"Quantity\", Int64.Type}, {\"Unit_Price\", type number}, {\"Discount\", type number}, {\"Sales\", type number}, {\"Profit\", type number}})",
                "in",
                "    #\"Changed Type\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Revenue",
            "expression": "SUM(Fact_Sales[Sales])",
            "formatString": "$#,##0.00"
          },
          {
            "name": "Total Profit",
            "expression": "SUM(Fact_Sales[Profit])",
            "formatString": "$#,##0.00"
          },
          {
            "name": "Total Orders",
            "expression": "DISTINCTCOUNT(Fact_Sales[Order_ID])",
            "formatString": "#,##0"
          },
          {
            "name": "Total Customers",
            "expression": "DISTINCTCOUNT(Fact_Sales[Customer_ID])",
            "formatString": "#,##0"
          },
          {
            "name": "Profit Margin %",
            "expression": "DIVIDE([Total Profit], [Total Revenue], 0)",
            "formatString": "0.00%"
          },
          {
            "name": "Avg Order Value",
            "expression": "DIVIDE([Total Revenue], [Total Orders], 0)",
            "formatString": "$#,##0.00"
          }
        ]
      },
      {
        "name": "Dim_Date",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "formatString": "yyyy-mm-dd",
            "isKey": true
          },
          {
            "name": "Year",
            "dataType": "int64",
            "sourceColumn": "Year"
          },
          {
            "name": "Month_Number",
            "dataType": "int64",
            "sourceColumn": "Month_Number"
          },
          {
            "name": "Month_Name",
            "dataType": "string",
            "sourceColumn": "Month_Name"
          },
          {
            "name": "Year_Month",
            "dataType": "string",
            "sourceColumn": "Year_Month"
          },
          {
            "name": "Quarter",
            "dataType": "string",
            "sourceColumn": "Quarter"
          }
        ],
        "partitions": [
          {
            "name": "Dim_Date-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = List.Dates(#date(2024, 1, 1), Duration.Days(#date(2025, 12, 31) - #date(2024, 1, 1)) + 1, #duration(1, 0, 0, 0)),",
                "    #\"Converted to Table\" = Table.FromList(Source, Splitter.SplitByNothing(), {\"Date\"}, null, ExtraValues.Error),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Converted to Table\",{{\"Date\", type datetime}}),",
                "    #\"Added Year\" = Table.AddColumn(#\"Changed Type\", \"Year\", each Date.Year([Date]), Int64.Type),",
                "    #\"Added Month Number\" = Table.AddColumn(#\"Added Year\", \"Month_Number\", each Date.Month([Date]), Int64.Type),",
                "    #\"Added Month Name\" = Table.AddColumn(#\"Added Month Number\", \"Month_Name\", each Date.ToText([Date], \"MMM\"), type text),",
                "    #\"Added Year Month\" = Table.AddColumn(#\"Added Month Name\", \"Year_Month\", each Date.ToText([Date], \"yyyy-MM\"), type text),",
                "    #\"Added Quarter\" = Table.AddColumn(#\"Added Year Month\", \"Quarter\", each \"Q\" & Text.From(Date.QuarterOfYear([Date])), type text)",
                "in",
                "    #\"Added Quarter\""
              ]
            }
          }
        ]
      },
      {
        "name": "Dim_Customer",
        "columns": [
          {
            "name": "Customer_ID",
            "dataType": "string",
            "sourceColumn": "Customer_ID",
            "isKey": true
          },
          {
            "name": "Customer_Name",
            "dataType": "string",
            "sourceColumn": "Customer_Name"
          },
          {
            "name": "Segment",
            "dataType": "string",
            "sourceColumn": "Segment"
          }
        ],
        "partitions": [
          {
            "name": "Dim_Customer-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"D:/Git Hub Projects/data/cleaned_sales_data.csv\"),[Delimiter=\",\", Columns=15, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    #\"Selected Columns\" = Table.SelectColumns(#\"Promoted Headers\",{\"Customer_ID\", \"Customer_Name\", \"Segment\"}),",
                "    #\"Removed Duplicates\" = Table.Distinct(#\"Selected Columns\")",
                "in",
                "    #\"Removed Duplicates\""
              ]
            }
          }
        ]
      },
      {
        "name": "Dim_Product",
        "columns": [
          {
            "name": "Product_ID",
            "dataType": "string",
            "sourceColumn": "Product_ID",
            "isKey": true
          },
          {
            "name": "Product_Name",
            "dataType": "string",
            "sourceColumn": "Product_Name"
          },
          {
            "name": "Category",
            "dataType": "string",
            "sourceColumn": "Category"
          },
          {
            "name": "Sub_Category",
            "dataType": "string",
            "sourceColumn": "Sub_Category"
          }
        ],
        "partitions": [
          {
            "name": "Dim_Product-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"D:/Git Hub Projects/data/cleaned_sales_data.csv\"),[Delimiter=\",\", Columns=15, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    #\"Selected Columns\" = Table.SelectColumns(#\"Promoted Headers\",{\"Product_ID\", \"Product_Name\", \"Category\", \"Sub_Category\"}),",
                "    #\"Removed Duplicates\" = Table.Distinct(#\"Selected Columns\")",
                "in",
                "    #\"Removed Duplicates\""
              ]
            }
          }
        ]
      },
      {
        "name": "Dim_Region",
        "columns": [
          {
            "name": "Region",
            "dataType": "string",
            "sourceColumn": "Region",
            "isKey": true
          }
        ],
        "partitions": [
          {
            "name": "Dim_Region-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"D:/Git Hub Projects/data/cleaned_sales_data.csv\"),[Delimiter=\",\", Columns=15, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    #\"Selected Columns\" = Table.SelectColumns(#\"Promoted Headers\",{\"Region\"}),",
                "    #\"Removed Duplicates\" = Table.Distinct(#\"Selected Columns\")",
                "in",
                "    #\"Removed Duplicates\""
              ]
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "Fact_Sales_Dim_Date",
        "fromTable": "Fact_Sales",
        "fromColumn": "Order_Date",
        "toTable": "Dim_Date",
        "toColumn": "Date"
      },
      {
        "name": "Fact_Sales_Dim_Customer",
        "fromTable": "Fact_Sales",
        "fromColumn": "Customer_ID",
        "toTable": "Dim_Customer",
        "toColumn": "Customer_ID"
      },
      {
        "name": "Fact_Sales_Dim_Product",
        "fromTable": "Fact_Sales",
        "fromColumn": "Product_ID",
        "toTable": "Dim_Product",
        "toColumn": "Product_ID"
      },
      {
        "name": "Fact_Sales_Dim_Region",
        "fromTable": "Fact_Sales",
        "fromColumn": "Region",
        "toTable": "Dim_Region",
        "toColumn": "Region"
      }
    ]
  }
}