{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.12.0/schema.json",
  "name": "Revenue_By_State",
  "position": {
    "x": 20,
    "y": 145,
    "z": 4000,
    "height": 360,
    "width": 780
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Dim_Region"
                    }
                  },
                  "Property": "State"
                }
              },
              "queryRef": "Dim_Region.State",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Fact_Sales"
                    }
                  },
                  "Property": "Total Revenue"
                }
              },
              "queryRef": "Fact_Sales.Total Revenue"
            }
          ]
        }
      }
    }
  }
}