                    "SourceRef": {
                      "Entity": "Dim_Date"
                    }
                  },
                  "Property": "Month_Name"
                }
              },
              "queryRef": "Dim_Date.Month_Name",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Fact_Sales"
                    }
                  },
                  "Property": "Total Revenue"
                }
              },
              "queryRef": "Fact_Sales.Total Revenue"
            }
          ]
        }
      }
    }
  }
}